<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_cat_igo" app:iconSpaceReserved="false">
        <Preference
            app:key="igo_folder"
            app:title="@string/pref_folder"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="all_profiles"
            app:defaultValue="false"
            app:title="@string/pref_all_profiles"
            app:summary="@string/pref_all_profiles_summary"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="launch_navigator"
            app:defaultValue="false"
            app:title="@string/pref_launch"
            app:summary="@string/pref_launch_summary"
            app:iconSpaceReserved="false" />
        <!-- Opens a list of the apps installed on the device (see SettingsActivity.pickApp). -->
        <Preference
            app:key="navigator_package"
            app:dependency="launch_navigator"
            app:title="@string/pref_package"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_weather" app:iconSpaceReserved="false">
        <ListPreference
            app:key="units"
            app:defaultValue="metric"
            app:entries="@array/units_names"
            app:entryValues="@array/units_values"
            app:title="@string/pref_units"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            app:key="interval_min"
            app:defaultValue="30"
            app:entries="@array/interval_names"
            app:entryValues="@array/interval_values"
            app:title="@string/pref_interval"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="play_sound"
            app:defaultValue="false"
            app:title="@string/pref_sound"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="stop_on_screen_off"
            app:defaultValue="false"
            app:title="@string/pref_stop_screen_off"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
