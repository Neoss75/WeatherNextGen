<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_glass"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:id="@+id/metric_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        app:tint="@color/on_weather"
        tools:src="@drawable/ic_humidity" />

    <TextView
        android:id="@+id/metric_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textAppearance="@style/TextAppearance.Weather.Label"
        tools:text="@string/label_humidity" />

    <TextView
        android:id="@+id/metric_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="@color/on_weather"
        tools:text="82%" />

    <TextView
        android:id="@+id/metric_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/on_weather_muted"
        tools:text="997 гПа" />
</LinearLayout>
