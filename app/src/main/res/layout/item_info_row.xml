<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the "Details" card: icon, small label, value and an optional note. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    tools:ignore="Overdraw"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/info_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:alpha="0.85"
        android:importantForAccessibility="no"
        app:tint="@color/on_weather"
        tools:src="@drawable/ic_folder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/info_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Weather.Label"
            tools:text="@string/info_folder" />

        <TextView
            android:id="@+id/info_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/on_weather"
            tools:text="/iGO_avic" />

        <TextView
            android:id="@+id/info_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/on_weather_muted"
            tools:text="save/profiles/01/userlists" />
    </LinearLayout>

    <ImageView
        android:id="@+id/info_chevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:alpha="0.6"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron"
        android:visibility="gone"
        app:tint="@color/on_weather"
        tools:visibility="visible" />
</LinearLayout>
